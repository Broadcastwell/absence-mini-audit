# Response headers for the Cloudflare Pages project absence-mini-audit.
#
# The page is one document with one inline script and one inline style block, so the
# policy names those two by hash rather than opening the document to unsafe-inline.
# A hash covers the exact bytes between the tags, which is why .gitattributes pins the
# checkout to LF and why tests/limits.test.mjs recomputes both hashes from
# public/index.html and fails if this file has drifted from the page.
#
# What the page loads, and nothing else: its own inline stylesheet, the two Inter
# subsets that stylesheet declares as @font-face and serves from this origin, the
# favicon from framerusercontent.com, the sample wheel from this origin, and same-origin
# requests to /api/analyze, /api/run, /api/link and /api/event. Inter used to come from a
# font CDN, which needed two more hosts here.
#
# style-src carries a second hash, for the one fixed font rule an exported image embeds
# (public/assets/fonts/inter-embed.css), because some browsers apply this policy to an SVG
# image's own stylesheet. It allows that exact rule and nothing else.
#
# img-src allows data: and blob: for one reason: the wheel's image export draws an SVG
# into a canvas in the browser, through a blob: URL, with Inter embedded as data:. No
# other directive was opened for it. scripts/build-page.mjs rewrites the two hashes and
# lib/headers.js; run it after editing the page.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'none'; script-src 'sha256-IlWgEJ//sBXtGLXSaRr8rpqnqZP5LlDUO6BSeae//zw='; style-src 'self' 'sha256-YOkNeYyCseWH93WGPkFbk34r/kvkhXVikKP0r5as68g=' 'sha256-7N3Rbo/cV2nIFxwN2KqGWQs18yi890aJoN+COVpucAA='; font-src 'self'; img-src 'self' data: blob: https://framerusercontent.com; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# /embed is the same page in its compact mode, for the find-your-company frame on
# broadcastwell.com. Its policy is the page's policy with one difference: it may be framed by
# broadcastwell.com, its subdomains and Framer's preview hosts, and by nothing else. The
# X-Frame-Options DENY of every other path is removed for it (frame-ancestors governs).
/embed
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'sha256-IlWgEJ//sBXtGLXSaRr8rpqnqZP5LlDUO6BSeae//zw='; style-src 'self' 'sha256-YOkNeYyCseWH93WGPkFbk34r/kvkhXVikKP0r5as68g=' 'sha256-7N3Rbo/cV2nIFxwN2KqGWQs18yi890aJoN+COVpucAA='; font-src 'self'; img-src 'self' data: blob: https://framerusercontent.com; connect-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors https://broadcastwell.com https://*.broadcastwell.com https://*.framer.app https://*.framer.website https://framer.com https://*.framercanvas.com; upgrade-insecure-requests

# The sample wheel is a standalone SVG image with Inter embedded. Served as its own
# document it would carry the page's policy above, which some browsers apply to its
# stylesheet and its data: font. It gets an image's policy instead: nothing runs, and the
# one fixed font rule is allowed by its hash. scripts/build-page.mjs keeps the hash current.
/assets/sample/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; style-src 'sha256-7N3Rbo/cV2nIFxwN2KqGWQs18yi890aJoN+COVpucAA='; font-src data:
